with "gtkada";

project Hexfront is
   for Source_Dirs use ("src/engine", "src/ui");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("hexfront.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2012", "-O2", "-gnatwa", "-gnaty3abcefhiklmnprt", "-g");
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-E");
   end Binder;
end Hexfront;
