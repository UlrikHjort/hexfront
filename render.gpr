with "gtkada";
project Render is
   for Source_Dirs use ("src/engine", "src/ui", "src/test");
   for Object_Dir use "obj/render";
   for Exec_Dir use "bin";
   for Main use ("render_png.adb", "render_preview.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2012", "-O1");
   end Compiler;
end Render;
