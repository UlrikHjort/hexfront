# World War II era definition.
# unit keys: id name class move target mp range soft hard def ammo fuel cost flags
#   class : infantry cavalry armor recon artillery anti_tank anti_air engineer
#           fortification fighter bomber
#   move  : foot horse wheeled tracked static air
#   other : air=<attack vs aircraft> spot=<vision> buy=no
#   flags : charge support bombard sapper   (comma separated)
era name=World_War_II
rule max_entrench=4 charge_bonus=0 square_bonus=0 close_armor_penalty=3

unit id=infantry  name=Infantry          class=infantry  move=foot    target=soft mp=3 soft=6  hard=2  air=1 def=6  ammo=8  cost=120
unit id=pioneers  name=Pioneers          class=engineer  move=foot    target=soft mp=3 soft=7  hard=4  air=1 def=6  ammo=6  cost=170 flags=sapper
unit id=mtninf    name=Mountain_Troops   class=infantry  move=foot    target=soft mp=4 soft=7  hard=2  def=7  ammo=8  cost=160
unit id=cavalry   name=Cavalry           class=cavalry   move=horse   target=soft mp=5 soft=5  hard=1  def=4  ammo=6  cost=110
unit id=armcar    name=Armoured_Car      class=recon     move=wheeled target=hard mp=8 soft=4  hard=2  def=4  ammo=6  fuel=60 cost=140
unit id=lighttank name=Light_Tank        class=armor     move=tracked target=hard mp=6 soft=5  hard=4  def=6  ammo=8  fuel=45 cost=200
unit id=medtank   name=Medium_Tank       class=armor     move=tracked target=hard mp=6 soft=7  hard=8  def=8  ammo=8  fuel=50 cost=300
unit id=heavytank name=Heavy_Tank        class=armor     move=tracked target=hard mp=4 soft=8  hard=10 def=12 ammo=7  fuel=35 cost=380
unit id=atgun     name=Anti-tank_Gun     class=anti_tank move=wheeled target=soft mp=4 soft=2  hard=9  def=4  ammo=6  fuel=30 cost=150
unit id=fieldart  name=Field_Artillery   class=artillery move=wheeled target=soft mp=4 range=3 soft=9  hard=4 def=3 ammo=6 fuel=30 cost=220 flags=support,bombard
unit id=heavyart  name=Heavy_Artillery   class=artillery move=wheeled target=soft mp=3 range=4 soft=11 hard=5 def=3 ammo=5 fuel=25 cost=300 flags=support,bombard
unit id=bunker    name=Bunker            class=fortification move=static target=hard mp=0 soft=7 hard=6 def=14 ammo=10 cost=300
unit id=flak      name=Flak_Gun          class=anti_air  move=wheeled target=soft mp=4 range=2 soft=3 hard=2 air=10 def=4 ammo=8 fuel=30 cost=170 flags=support

# Aircraft: one per hex in the air layer; refuel at own airfields/towns.
unit id=fighter   name=Fighter           class=fighter   move=air target=air mp=9 soft=3  hard=1 air=10 def=8 ammo=6 fuel=40 cost=300
unit id=divebomb  name=Dive_Bomber       class=bomber    move=air target=air mp=7 soft=10 hard=9 air=2  def=5 ammo=4 fuel=35 cost=340
unit id=medbomb   name=Medium_Bomber     class=bomber    move=air target=air mp=8 soft=12 hard=5 air=3  def=6 ammo=3 fuel=45 cost=380
