project Selftest is
   for Source_Dirs use ("src/engine", "src/test");
   for Object_Dir use "obj/test";
   for Exec_Dir use "bin";
   for Main use ("selftest.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2012", "-O2", "-gnatwa", "-g", "-gnata");
   end Compiler;
   package Binder is
      for Default_Switches ("Ada") use ("-E");
   end Binder;
end Selftest;
